<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="HumanResourceManagement.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:HumanResourceManagement.Views"
       Shell.FlyoutBehavior="Disabled"
       Title="HumanResourceManagement">

    <TabBar>
        <ShellContent Title="Add task" Route="AddTaskPage"
                      ContentTemplate="{DataTemplate views:AddTaskPage}" />
        <ShellContent Title="Todo list" Route="TodoListPage"
                      ContentTemplate="{DataTemplate views:TodoListPage}" />
        <ShellContent Title="Weather" Route="WeatherPage"
                      ContentTemplate="{DataTemplate views:WeatherPage}" />
    </TabBar>
</Shell>