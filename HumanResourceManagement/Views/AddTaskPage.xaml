<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HumanResourceManagement.ViewModels"
             xmlns:local="clr-namespace:HumanResourceManagement"
             x:Class="HumanResourceManagement.Views.AddTaskPage"
             x:DataType="vm:AddTaskViewModel"
             Title="Add task">

    <ContentPage.Resources>
        <Style x:Key="Headline" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="20" RowSpacing="12" ColumnSpacing="12"
          RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,*">

        <!-- Row 0: Title Header & Counter -->
        <Label Text="New task" Style="{StaticResource Headline}" Grid.Row="0" Grid.Column="0" />
        <Label Text="{Binding TitleCounter}" Grid.Row="0" Grid.Column="1"
               TextColor="Gray" HorizontalOptions="End" VerticalOptions="End" />

        <!-- Row 1: Title Entry -->
        <Entry x:Name="TitleEntry" Placeholder="Title" Grid.Row="1" Grid.ColumnSpan="2"
               Text="{Binding Title}"
               ReturnCommand="{Binding SaveCommand}" />

        <!-- Row 2: Notes Editor -->
        <Editor x:Name="NotesEditor" Placeholder="Notes" Grid.Row="2" Grid.ColumnSpan="2"
                Text="{Binding Notes}" />

        <!-- Row 3: Category Picker & Due DatePicker -->
        <Picker x:Name="CategoryPicker" Title="Category" Grid.Row="3" Grid.Column="0"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding Category}" />
        <DatePicker x:Name="DueDatePicker" Format="dd.MM.yyyy" Grid.Row="3" Grid.Column="1"
                    Date="{Binding DueDate}" />

        <!-- Row 4: Reminder Switch & Priority Stepper -->
        <HorizontalStackLayout Grid.Row="4" Grid.Column="0" Spacing="8" VerticalOptions="Center">
            <Label Text="Reminder" VerticalOptions="Center" />
            <Switch IsToggled="{Binding Reminder}" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Grid.Column="1" Spacing="8" VerticalOptions="Center">
            <Label VerticalOptions="Center"
                   Text="{Binding Priority, StringFormat='Priority {0}'}" />
            <Stepper x:Name="PriorityStepper" Minimum="1" Maximum="5" Value="{Binding Priority}" Increment="1" />
        </HorizontalStackLayout>

        <!-- Row 5: Save Button -->
        <Button Text="Save" Command="{Binding SaveCommand}" Grid.Row="5" Grid.ColumnSpan="2" />

        <!-- Row 6: Result Label -->
        <Label Text="{Binding Result}" TextColor="{StaticResource Primary}" Grid.Row="6" Grid.ColumnSpan="2" />

        <Grid Grid.Row="7" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Placeholder="New category" Text="{Binding NewCategory}"
           ReturnCommand="{Binding AddCategoryCommand}" />
            <Button Grid.Column="1" Text="Add category" Command="{Binding AddCategoryCommand}" />
        </Grid>

    </Grid>
</ContentPage>